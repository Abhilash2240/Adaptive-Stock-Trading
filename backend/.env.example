# Backend configuration. This is the canonical backend environment file.
PORT=8001
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@host/dbname

# Market data: supported providers are mock and twelvedata.
DATA_PROVIDER=mock
SYMBOLS=AAPL,MSFT,TSLA
MOCK_STREAM_INTERVAL=1.0
TWELVEDATA_API_KEY=
TWELVEDATA_POLL_INTERVAL=60.0

# Auth0 API configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
# IMPORTANT: Set AUTH0_ROLES_CLAIM to match the custom claim namespace in your Auth0 tenant's Post-Login Action.
# Example: "https://yourapp/roles" or "roles" or "https://trading-platform.example.com/roles"
# If not set, defaults to "https://yourapp/roles"
AUTH0_ROLES_CLAIM=https://yourapp/roles

ALLOWED_ORIGINS=http://localhost:5173
AGENT_MODEL_NAME=ppo-default
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
TRUST_PROXY=false

# OpenRouter rationale explanations (optional; use the free, rate-limited model locally)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Free-tier alternative: nvidia/nemotron-3-ultra-550b-a55b:free (rate-limited, zero cost)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
